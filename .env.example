# Postgres (Neon) — server-only, never shipped to the client
DATABASE_URL=

# Signs the /admin session cookie (>= 32 random bytes, e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Single shared password for /admin (>= 12 chars)
ADMIN_PASSWORD=

# Wedding RSVP close date, interpreted in Asia/Manila (e.g. 2027-06-01).
# Ship-gated: the couple decides. Absent = form stays open and shows a graceful
# "date to be announced" state (see lib/deadline.ts when added).
RSVP_DEADLINE_DATE=
